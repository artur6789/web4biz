ErrorDocument 404 /404.html

RewriteEngine On

# Legacy language URLs. THE_REQUEST prevents a loop after DirectoryIndex.
RewriteCond %{THE_REQUEST} "\s/+index\.html(?:[?\s])" [NC]
RewriteCond %{QUERY_STRING} ^lang=en$
RewriteRule ^index\.html$ https://www.web4biz.pl/index-en.html [R=301,END,QSD]

RewriteCond %{THE_REQUEST} "\s/+(?:index\.html)?(?:[?\s])" [NC]
RewriteCond %{QUERY_STRING} ^lang=pl$
RewriteRule ^(?:index\.html)?$ https://www.web4biz.pl/ [R=301,END,QSD]

RewriteCond %{QUERY_STRING} ^lang=pl$
RewriteRule ^projects\.html$ https://www.web4biz.pl/projects.html [R=301,END,QSD]

RewriteCond %{QUERY_STRING} ^lang=en$
RewriteRule ^projects\.html$ https://www.web4biz.pl/projects-en.html [R=301,END,QSD]

RewriteCond %{THE_REQUEST} "\s/+index\.html(?:[?\s])" [NC]
RewriteRule ^index\.html$ https://www.web4biz.pl/ [R=301,END]

# Leave request bodies intact for integrations and redirect public page requests.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.web4biz\.pl$ [NC]
RewriteRule ^ https://www.web4biz.pl%{REQUEST_URI} [R=301,END,NE]
